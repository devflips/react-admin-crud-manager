{
  "name": "react-admin-crud-manager",
  "version": "1.0.22",
  "description": "A reusable React CRUD admin template with modular components.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist",
    "dist/tailwind.css"
  ],
  "keywords": [
    "react",
    "admin",
    "crud",
    "template",
    "component-library"
  ],
  "author": "Dev Flips",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devflips/react-admin-crud-manager.git"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node build-css.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@tinymce/tinymce-react": "^6.3.0",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.446.0",
    "notistack": "^3.0.2",
    "prop-types": "^15.8.1",
    "react-router-dom": "^7.9.1",
    "tinymce": "^8.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.4.15",
    "tailwindcss": "3.3.3",
    "vite": "^5.0.8"
  }
}
